time_unit = 'days
compartments { S, I, R }
parameters {
  beta  : rate
  gamma : rate
  N0    : count
  I0    : count
}
let mu : rate = 20 / 100_000 'per_year
let N = S + I + R
transitions {
  infection : S --> I @ beta * S * I / N
  recovery  : I --> R @ gamma * I
}
init {
  S = N0 - I0
  I = I0
}
