# SIR model for the 1978 boarding school influenza outbreak.
# Same dynamics as boarding_school_sir.camdl; NegBin observation
# with estimable dispersion parameter k.

time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate     in [0.5, 5.0]
  gamma : rate     in [0.1, 1.0]
  k     : real     in [1.0, 1000.0]   # NegBin dispersion; large k → Poisson
  N0    : count
  I0    : count
}

let N = S + I + R

transitions {
  infection : S --> I  @ beta * S * I / N
  recovery  : I --> R  @ gamma * I
}

init {
  S = N0 - I0
  I = I0
}

observations {
  in_bed : {
    projected  = prevalence(I)
    every      = 1 'days
    likelihood = neg_binomial(mean = projected, r = k)
  }
}

scenarios {
  baseline {
    label = "Boarding school flu, 1978, NegBin obs"
    set = {
      N0 = 763
      I0 = 5
    }
  }
}

simulate {
  from = 0 'days
  to   = 14 'days
}
