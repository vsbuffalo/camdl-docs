# Constant-reporting variant of seed_timing_report_prior.camdl, for model
# comparison. Identical dynamics and priors, but the reporting fraction is a
# single constant `rho` instead of a logistic ramp rho(t). This is the "naive"
# model: it cannot represent surveillance scaling up over the early window, so
# it should fit worse than the ramp model — the question the `camdl compare`
# ELPD answers is *how much* worse, i.e. whether the ramp is necessary.
# Same number of ESTIMATED parameters as the ramp model (6: beta, gamma, tau,
# lambda, rho, k), so the comparison is apples-to-apples (no complexity penalty).
time_unit = 'days

compartments { S, I, R }

parameters {
  beta   : rate        in [0.001, 5.0]  ~ log_normal(mu = -0.92, sigma = 0.4)
  gamma  : rate        in [0.01, 1.0]   ~ log_normal(mu = -1.97, sigma = 0.4)
  tau    : real        in [0.0, 45.0]   ~ uniform(lower = 0.0, upper = 45.0)
  lambda : positive    in [0.0, 100.0]  ~ exponential(rate = 0.5)
  w      : positive    in [0.1, 20.0]
  N0     : count        in [100, 1000000]
  rho    : probability in [0.0, 1.0]    ~ beta(alpha = 2.0, beta = 3.0)
  k      : positive    in [0.1, 1000.0] ~ log_normal(mu = 3.0, sigma = 1.0)
}

let N = S + I + R

transitions {
  #[lineage]
  infection : S --> I  @ beta * S * I / N
  recovery  : I --> R  @ gamma * I
  seed      :     --> I  @ lambda / (1 + exp(-(t - tau) / w))
}

observations {
  cases : {
    projected  = incidence(infection)
    every      = 1 'days
    likelihood = neg_binomial(mean = rho * projected, r = k)
  }
}

init {
  S = N0
  I = 0
}

simulate {
  from = 0 'days
  to   = 120 'days
}
