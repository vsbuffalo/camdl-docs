# Overdispersed variant of seed_timing_report_prior.camdl, for model comparison.
# Identical to the rho(t) prior model but the transmission rate carries
# extra-demographic Gamma process noise (He et al. 2010):
#   infection @ overdispersed(beta * S * I / N, sigma_se)
# sigma_se is the variance of a mean-1 Gamma multiplier; sigma_se -> 0 recovers
# the Poisson rho(t) model, so the two NEST. The `camdl compare` ELPD answers
# whether the data want process noise on top of the reporting ramp once tau is
# estimated (the earlier finding: with tau free, they largely don't).
# overdispersed() requires the chain_binomial or tau_leap backend; PMMH (not
# PGAS) estimates sigma_se fine — PGAS's NUTS gradient omits the overdispersion
# derivative (camdl audit C1).
time_unit = 'days

compartments { S, I, R }

parameters {
  beta     : rate        in [0.001, 5.0]   ~ log_normal(mu = -0.92, sigma = 0.4)
  gamma    : rate        in [0.01, 1.0]    ~ log_normal(mu = -1.97, sigma = 0.4)
  tau      : real        in [0.0, 45.0]    ~ uniform(lower = 0.0, upper = 45.0)
  lambda   : positive    in [0.0, 100.0]   ~ exponential(rate = 0.5)
  w        : positive    in [0.1, 20.0]
  N0       : count        in [100, 1000000]
  rho_max  : probability in [0.0, 1.0]     ~ beta(alpha = 2.0, beta = 3.0)
  t_rep    : real        in [0.0, 120.0]
  w_rep    : positive    in [0.1, 30.0]
  k        : positive    in [0.1, 1000.0]  ~ log_normal(mu = 3.0, sigma = 1.0)
  sigma_se : positive    in [0.0001, 2.0]  ~ exponential(rate = 5.0)
}

let N = S + I + R
let rho_t = rho_max / (1 + exp(-(t - t_rep) / w_rep))

transitions {
  #[lineage]
  infection : S --> I  @ overdispersed(beta * S * I / N, sigma_se)
  recovery  : I --> R  @ gamma * I
  seed      :     --> I  @ lambda / (1 + exp(-(t - tau) / w))
}

observations {
  cases : {
    projected  = incidence(infection)
    every      = 1 'days
    likelihood = neg_binomial(mean = rho_t * projected, r = k)
  }
}

init {
  S = N0
  I = 0
}

simulate {
  from = 0 'days
  to   = 120 'days
}
