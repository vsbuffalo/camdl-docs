# SIR model for the 1978 boarding school influenza outbreak.
#
# Closed population (N = 763 boys), 14 daily observations of "in bed"
# = prevalence(I). Poisson observation: matron headcounts are direct
# integer counts, no reporting fraction.

time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate     in [0.5, 5.0]
  gamma : rate     in [0.1, 1.0]
  N0    : count
  I0    : count
}

let N = S + I + R

transitions {
  infection : S --> I  @ beta * S * I / N
  recovery  : I --> R  @ gamma * I
}

init {
  S = N0 - I0
  I = I0
}

observations {
  in_bed : {
    projected  = prevalence(I)
    every      = 1 'days
    likelihood = poisson(rate = projected)
  }
}

scenarios {
  baseline {
    label = "Boarding school flu, 1978"
    # I(0) = 3 from the BMJ source: "On Sunday 22 January three boys
    # were in the college infirmary." (Anonymous 1978, BMJ 1:587)
    set = {
      N0 = 763
      I0 = 3
    }
  }
}

simulate {
  from = 0 'days
  to   = 14 'days
}
