# SIR with process noise on β (gamma-noise on the infection rate; He et al. 2010)
# Compared to the Poisson-obs fixed-β fit to isolate process vs observation noise.
# Obs model is Poisson (no observation overdispersion) so σ_se absorbs all
# residual variance beyond mean-field dynamics.

time_unit = 'days

compartments { S, I, R }

parameters {
  beta     : rate     in [0.5, 7.0]
  gamma    : rate     in [0.1, 1.0]
  sigma_se : positive in [0.001, 2.0]
  N0       : count
  I0       : count
}

let N = S + I + R

transitions {
  infection : S --> I  @ overdispersed(beta * S * I / N, sigma_se)
  recovery  : I --> R  @ gamma * I
}

init {
  S = N0 - I0
  I = I0
}

observations {
  in_bed : {
    projected  = prevalence(I)
    every      = 1 'days
    likelihood = poisson(rate = projected)
  }
}

scenarios {
  baseline {
    label = "Boarding school flu, 1978 — process noise on β"
    # I(0) = 3 from the BMJ source: "On Sunday 22 January three boys
    # were in the college infirmary." (Anonymous 1978, BMJ 1:587)
    set = {
      N0 = 763
      I0 = 3
    }
  }
}

simulate {
  from = 0 'days
  to   = 14 'days
}
