# Single-population SIR with #[lineage] transmission, no environmental noise.
# Pairs with sir_lineage_od.camdl (identical except the overdispersed() wrapper)
# for the with/without-overdispersion tree comparison.
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate  in [0.001, 2.0]
  gamma : rate  in [0.001, 1.0]
  N0    : count in [100, 100000]
  I0    : count in [1, 1000]
}

let N = S + I + R

transitions {
  #[lineage]
  infection : S --> I  @ beta * S * I / N
  recovery  : I --> R  @ gamma * I
}

init {
  S = N0 - I0
  I = I0
}

simulate {
  from = 0 'days
  to   = 80 'days
}
