# Measles SEIR — He et al. (2010) replication in camdl
# J. R. Soc. Interface 7: 271–283
# Parameters from MLE fit to London weekly notifications, 1944–1964.
#
# This is the *clean* model used by the he2010-paper and he2010-pomp
# external-validation chapters. Faithful to the pomp He2010 vignette:
# - Time-varying pop(t) and birthrate(t) from interpolated covariates
# - Deterministic births with cohort pulse via events block
# - 365.25-day periodic forcing matching pomp's exact school calendar
# - Overdispersed infection rate (Gamma noise on per-capita FOI)
# - Observation = incidence(recovery) matching pomp's C accumulator
# - **No interventions.** That's a separate chapter.
#
# Bounds were chosen to bracket He et al. Table 2 estimates across all
# 20 cities, with modest head-room. Tighter than the prelim chapter's
# bounds in two places:
#   - iota: [0.1, 20] (prelim used [0.01, 100]). He et al. Table 2:
#     0.01 (Halesworth) to 2.90 (London).
#   - alpha: [0.5, 1.05] (prelim used [0.5, 1.2]). The mixing exponent
#     >1 ("super-mixing") is not physical; allow a small buffer past 1
#     for profile-tail visibility.

time_unit = 'days

compartments { S, E, I, R }

parameters {
  R0        : positive    in [1.0, 100.0]
  sigma     : rate        in [0.01, 0.5]    # 1/latent period (day^-1)
  gamma     : rate        in [0.01, 0.5]    # 1/infectious period (day^-1)
  mu        : rate        in [1e-6, 0.01]   # death rate (day^-1)
  alpha     : positive [1] in [0.5, 1.05]   # mixing exponent (dimensionless)
  iota      : count       in [0.1, 20.0]    # importation floor
  sigma_se  : positive [1] in [0.001, 5.0]  # extra-demographic noise σ²
  amplitude : probability in [0.1, 0.9]    # term-time forcing amplitude
  cohort    : probability in [0.0001, 0.9999] # fraction of births at school start
  rho       : probability in [0.0001, 0.9999] # reporting probability
  psi       : positive [1] in [0.001, 1.0]  # measurement overdispersion
  s0        : probability in [0.001, 0.5]   # initial susceptible fraction
  e0        : probability in [1e-6, 0.01]   # initial exposed fraction
  i0        : probability in [1e-6, 0.01]   # initial infected fraction
  N0        : count       in [1000, 10000000]
}

# ── Time-varying covariates ──────────────────────────────────────────────────
forcing {
  pop : interpolated 'count {
    data      = "data/he2010_london_covariates.tsv"
    time_col  = t
    value_col = pop
    method    = "linear"
  }

  birthrate : interpolated 'per_year {
    data      = "data/he2010_london_covariates.tsv"
    time_col  = t
    value_col = birthrate
    method    = "linear"
  }

  # UK school calendar matching pomp exactly.
  school : periodic 'ratio {
    period = 365.25 'days
    step   = 1 'days
    on     = [7:100, 115:199, 252:300, 308:356]
  }
}

# ── Rate expressions ─────────────────────────────────────────────────────────

let beta_base = R0 * (1.0 - exp(-(gamma + mu) * dt)) / dt

# Seasonal forcing: mean(seas) = 1 over the year.
let seas = 1.0 - amplitude + amplitude * (1.0 + 0.2411 / 0.7589) * school(t)

let daily_births = birthrate(t) * pop(t)

transitions {
  infection : S --> E  @ overdispersed(beta_base * seas * S * unchecked_dim((I + iota) ^ alpha, dim = population, reason = "He et al. alpha-mixing: phenomenological P^alpha term") / pop(t), sigma_se)

  latency   : E --> I  @ sigma * E
  recovery  : I --> R  @ gamma * I

  birth : --> S  @ deterministic((1.0 - cohort) * daily_births)

  death_S : S -->  @ mu * S
  death_E : E -->  @ mu * E
  death_I : I -->  @ mu * I
  death_R : R -->  @ mu * R
}

init {
  S = s0 * N0
  E = e0 * N0
  I = i0 * N0
  R = N0 - s0 * N0 - e0 * N0 - i0 * N0
}

# Cohort: children enter school once per year on day 251.
events {
  cohort_entry : add(S, cohort * birthrate(t) * pop(t) * 1 'years)
    every 365.25 'days at_day 258
}

# Match pomp's R = nearbyint(pop) - S - E - I constraint.
balance {
  R = pop(t) - S - E - I
}

# He et al. observe C = cumulative I→R recoveries per week.
observations {
  weekly_cases : {
    projected  = incidence(recovery)
    every      = 7 'days
    likelihood = normal(
      mean = rho * projected,
      sd   = sqrt(rho * projected * (1.0 - rho + psi * psi * rho * projected))
    )
  }
}

simulate {
  from = 0 'days
  to   = 21 'years
}
